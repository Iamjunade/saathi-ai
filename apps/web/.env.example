# SAATHI Web Frontend - Environment Configuration
# Copy this file to .env.local and fill in the values

# Google Gemini API Key (Required for LLM-based reasoning in Agent Orchestrator)
# Get a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Fallback OpenStreetMap Location Service (No API Key Required)
# The web app uses standard browser Geolocation API and OpenStreetMap Nominatim/Overpass.
